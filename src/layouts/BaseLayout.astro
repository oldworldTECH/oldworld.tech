---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = 'IT infrastructure and homelab engineering logs.',
  ogType = 'website',
  pubDate,
  updatedDate,
} = Astro.props;

// build.format: 'file' makes Astro.url.pathname end in .html during the build,
// but Pages serves those paths without the extension. Strip it so the canonical
// and og:url match the URL that actually resolves.
const canonicalPath = Astro.url.pathname.replace(/(?:index)?\.html$/, '') || '/';
const canonical = new URL(canonicalPath, Astro.site);
const rssHref = new URL('rss.xml', Astro.site);
const buildYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'"
  />
  <title>{title} // oldworld.tech</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="oldworld.tech" href={rssHref} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="oldworld.tech" />
  {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <meta name="twitter:card" content="summary" />

  <style is:global>
    /* "Old World Tech" Design System Tokens */
    :root {
      --bg: #121212;
      --text-bone: #E5E5E5;
      --accent-amber: #FFB000;
      --accent-green: #33FF33;
      --border-rigid: #2A2A2A;
      --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text-bone);
      font-family: var(--font-sans);
      line-height: 1.6;
      padding: 2rem 1rem;
    }

    h1, h2, h3, nav, .meta-text {
      font-family: var(--font-mono);
      font-weight: 600;
    }

    /* Minimalist Rigid Terminal Frame Layout */
    .container {
      max-width: 800px;
      margin: 0 auto;
      border: 1px solid var(--border-rigid);
      background: #161616;
    }

    header.site-header {
      border-bottom: 1px solid var(--border-rigid);
      padding: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    header.site-header .logo a {
      color: var(--accent-amber);
      text-decoration: none;
      font-size: 1.1rem;
    }

    nav { display: flex; gap: 1rem; }
    nav a {
      color: var(--text-bone);
      text-decoration: none;
      font-size: 0.9rem;
    }
    nav a:hover {
      color: var(--accent-green);
    }

    main { padding: 2rem 1.5rem; }

    footer {
      border-top: 1px solid var(--border-rigid);
      padding: 1rem 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="site-header">
      <div class="logo"><a href="/">OLDWORLD.TECH //</a></div>
      <nav>
        <a href="/">[LOGS]</a>
        <a href="/rss.xml">[RSS]</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer><span>SYSTEM: ONLINE // BUILD: {buildYear}</span></footer>
  </div>
</body>
</html>
