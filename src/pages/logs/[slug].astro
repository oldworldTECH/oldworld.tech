---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedLogs } from '../../lib/logs';

export async function getStaticPaths() {
  const logEntries = await getPublishedLogs();
  return logEntries.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
>
  <div class="log-meta">
    <span>[STATUS]: <span class="status-val">{entry.data.status.toUpperCase()}</span></span>
    <span>[DATE]: {entry.data.pubDate.toISOString().split('T')[0]}</span>
    {entry.data.updatedDate && (
      <span>[UPDATED]: {entry.data.updatedDate.toISOString().split('T')[0]}</span>
    )}
  </div>

  <h1 class="log-title">{entry.data.title}</h1>
  <hr class="log-divider" />

  <article class="prose-content">
    <Content />
  </article>
</BaseLayout>

<style>
  .log-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-green);
    margin-bottom: 0.5rem;
    display: flex;
    gap: 1.5rem;
  }
  .status-val { color: var(--accent-amber); }
  .log-title {
    color: #FFF;
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }
  .log-divider {
    border: 0;
    border-top: 1px solid var(--border-rigid);
    margin-bottom: 2rem;
  }

  /* Target compiled markdown elements natively */
  .prose-content :global(h2) {
    font-family: var(--font-mono);
    color: var(--accent-amber);
    font-size: 1.2rem;
    margin: 2rem 0 0.75rem 0;
  }
  .prose-content :global(h3) {
    font-family: var(--font-mono);
    color: var(--text-bone);
    font-size: 1.05rem;
    margin: 1.5rem 0 0.5rem 0;
  }
  .prose-content :global(p) { margin-bottom: 1rem; color: #CCC; font-size: 0.95rem; }
  .prose-content :global(ol),
  .prose-content :global(ul) { margin: 0 0 1rem 1.25rem; color: #CCC; font-size: 0.95rem; }
  .prose-content :global(li) { margin-bottom: 0.5rem; }
  .prose-content :global(li > ul),
  .prose-content :global(li > ol) { margin-top: 0.5rem; }
  .prose-content :global(strong) { color: var(--text-bone); font-weight: 600; }
  .prose-content :global(a) { color: var(--accent-green); }
  .prose-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-rigid);
    margin: 2rem 0;
  }
  .prose-content :global(blockquote) {
    border-left: 1px solid var(--accent-amber);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #999;
  }
  .prose-content :global(img) { max-width: 100%; height: auto; border: 1px solid var(--border-rigid); }

  /* Code blocks. Prism, not Shiki: Shiki's inline styles are blocked by the CSP. */
  .prose-content :global(pre) {
    background: #131313;
    border: 1px solid var(--border-rigid);
    padding: 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .prose-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  /* Inline code only; the :not() keeps it off code inside a pre. */
  .prose-content :global(:not(pre) > code) {
    background: #1C1C1C;
    border: 1px solid var(--border-rigid);
    padding: 0.1rem 0.35rem;
    color: var(--accent-amber);
  }

  /* Prism theme, restricted to the design tokens. #5A5A5A is the one new value:
     a dim grey for comments and punctuation that amber/green/bone can't cover. */
  .prose-content :global(pre code) { color: var(--text-bone); }
  .prose-content :global(.token.comment),
  .prose-content :global(.token.prolog),
  .prose-content :global(.token.doctype),
  .prose-content :global(.token.cdata),
  .prose-content :global(.token.punctuation) { color: #5A5A5A; }
  .prose-content :global(.token.keyword),
  .prose-content :global(.token.builtin),
  .prose-content :global(.token.function),
  .prose-content :global(.token.selector),
  .prose-content :global(.token.tag),
  .prose-content :global(.token.important) { color: var(--accent-amber); }
  .prose-content :global(.token.string),
  .prose-content :global(.token.char),
  .prose-content :global(.token.attr-value),
  .prose-content :global(.token.inserted),
  .prose-content :global(.token.regex) { color: var(--accent-green); }
  .prose-content :global(.token.number),
  .prose-content :global(.token.boolean),
  .prose-content :global(.token.constant),
  .prose-content :global(.token.symbol),
  .prose-content :global(.token.variable),
  .prose-content :global(.token.parameter),
  .prose-content :global(.token.attr-name),
  .prose-content :global(.token.property),
  .prose-content :global(.token.operator),
  .prose-content :global(.token.entity),
  .prose-content :global(.token.url) { color: var(--text-bone); }
  .prose-content :global(.token.deleted) { color: #A04040; }


  /* High-Contrast Rigid System Tables */
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin: 1.5rem 0;
  }
  .prose-content :global(th) {
    background: #1C1C1C;
    border: 1px solid var(--border-rigid);
    padding: 0.6rem;
    color: var(--accent-green);
    text-align: left;
  }
  .prose-content :global(td) {
    border: 1px solid var(--border-rigid);
    padding: 0.6rem;
  }
</style>